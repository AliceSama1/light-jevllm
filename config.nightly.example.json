{
  "model": "nightly-control-plane",
  "upstream_url": "http://127.0.0.1:8000",
  "upstream_model": "my-vllm-model",
  "family": "token_logit",
  "backend": "vllm_nightly",
  "parallel_protocol_version": "light-jevllm.parallel.v1",
